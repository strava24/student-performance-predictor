# Conda environment (created with `conda create -p ./venv`)
/venv

# Package build metadata generated by `pip install -e .`
*.egg-info/
build/
dist/

# Logs generated at runtime
artifacts/
logs/
*.log

# Python bytecode and caches
__pycache__/
*.py[cod]

# Jupyter
.ipynb_checkpoints/

# OS / editor files
.DS_Store
.vscode/
.idea/

# CatBoost training logs (written to the working directory on fit)
catboost_info/
